[Unit]
Description=cfddns — 同步本机公网 IP 到 Cloudflare DNS
Documentation=file:%h/.cfddns/config.yaml
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 注意: 把 User 改成实际运行者；HOME 必须指向该用户主目录，
# 否则 cfddns 找不到 ~/.cfddns/config.yaml。
User=root
Group=root
Environment=HOME=/root
ExecStart=/usr/local/bin/cfddns --quiet
# 网络抖动时自动重试，指数退避
Restart=on-failure
RestartSec=30s
TimeoutStartSec=120
# 加固：只需要网络与配置目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.cfddns
